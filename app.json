{
  "expo": {
    "name": "STRIDE",
    "slug": "stride",
    "version": "0.2.0",
    "scheme": "stride",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0F",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.cyberzbit.stride",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow STRIDE to measure the distance of walks you record.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ]
    ]
  }
}
